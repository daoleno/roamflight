/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'self'; base-uri 'self'
/
  Cache-Control: public, no-cache, no-transform
/index.html
  Cache-Control: public, no-cache, no-transform
/credits.html
  Cache-Control: public, no-cache, no-transform
/credits
  Cache-Control: public, no-cache, no-transform
/404.html
  Cache-Control: public, no-cache, no-transform
/auth/complete
  Cache-Control: public, no-cache, no-transform
/auth/complete.html
  Cache-Control: public, no-cache, no-transform
/app/*
  Cache-Control: public, max-age=31536000, immutable
/healthz
  Cache-Control: no-store
/health.json
  Cache-Control: no-store
/assets/*
  Cache-Control: public, max-age=3600, must-revalidate
/assets/terrain.bytes
  Content-Type: application/octet-stream
/assets/outlines.bin
  Content-Type: application/octet-stream
/assets/plane.fbx
  Content-Type: application/octet-stream
