/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'self'; base-uri 'self'
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/credits.html
  Cache-Control: no-cache
/healthz
  Cache-Control: no-store
/health.json
  Cache-Control: no-store
/assets/*
  Cache-Control: public, max-age=3600, must-revalidate
/assets/terrain.bytes
  Content-Type: application/octet-stream
/assets/outlines.bin
  Content-Type: application/octet-stream
/assets/plane.fbx
  Content-Type: application/octet-stream
