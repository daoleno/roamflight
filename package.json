    "lucide": "^0.468.0",
    "sirv": "^3.0.2",
    "three": "^0.180.0",
    "three-mesh-bvh": "^0.9.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "vite": "^7.1.0"
  }
}
